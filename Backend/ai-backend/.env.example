# ───────── Base de datos (Supabase Session pooler, puerto 5432) ─────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?connection_limit=5"

# ───────── Auth ─────────
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=30d
ACCESS_TOKEN_TTL=1d          # opcional (default 1d)
REFRESH_TOKEN_TTL_DAYS=30    # opcional (default 30)

# ───────── IA ─────────
OPENAI_API_KEY=
XAI_API_KEY=                 # TTS (pendiente créditos)
GEMINI_API_KEY=              # voz en tiempo real de cursos (opcional)

# ───────── Email (Resend) ─────────
RESEND_API_KEY=
EMAIL_ENABLED=false          # true para enviar de verdad; false solo loguea el link
EMAIL_FROM=no-reply@tudominio.com

# ───────── URLs / CORS ─────────
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
PORT=3000
NODE_ENV=development

# ───────── Supabase Storage (bucket público `social`) ─────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SOCIAL_RETENTION_DAYS=15     # opcional (default 15)

# ───────── IAP / Suscripciones (RevenueCat) ─────────
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_API_KEY=          # opcional, solo para /billing/sync
RC_ENTITLEMENT_PRO=pro
RC_ENTITLEMENT_CHEF=chef

# ───────── Observabilidad ─────────
SENTRY_DSN=                  # si está, reporta los 5xx
